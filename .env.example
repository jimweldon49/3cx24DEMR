# Service
PORT=8080
LOG_LEVEL=info
PUBLIC_BASE_URL=https://integration.your-domain.com

# 3CX Call Flow Designer webhooks (src/routes/webhooks.js) -- optional, separate
# integration path from the CRM Integration Template below.
THREE_CX_TENANT_URL=https://yourtenant.3cx.us
THREE_CX_WEBHOOK_SECRET=replace-with-random-shared-secret

# 3CX CRM Integration Template (Server Side) auth -- must match the ApiKey
# parameter configured in 3CX Management Console > Settings > CRM Integration.
# Also used to sign the short-lived /crm/patient-summary links.
CRM_TEMPLATE_API_KEY=replace-with-random-shared-secret

# 4D EMR
FOURD_EMR_BASE_URL=https://api.your-4d-emr.com
FOURD_EMR_APP_BASE_URL=https://app.4d-emr.com
FOURD_EMR_CLIENT_ID=
FOURD_EMR_CLIENT_SECRET=
FOURD_EMR_CLIENT_ID_HEADER=client-id
FOURD_EMR_CLIENT_SECRET_HEADER=client-secret
# Optional third auth header (use when API requires 3 headers)
FOURD_EMR_EXTRA_AUTH_HEADER_NAME=
FOURD_EMR_EXTRA_AUTH_HEADER_VALUE=
# Optional alternatives to client-id/secret
FOURD_EMR_API_KEY=
FOURD_EMR_BEARER_TOKEN=
FOURD_EMR_OAUTH_TOKEN_URL=
FOURD_EMR_OAUTH_CLIENT_ID=
FOURD_EMR_OAUTH_CLIENT_SECRET=
FOURD_EMR_OAUTH_SCOPE=
FOURD_EMR_OAUTH_AUDIENCE=

# 4D EMR patient lookup mapping
FOURD_EMR_PATIENT_LOOKUP_PATH=/api/public/patients
FOURD_EMR_PATIENT_LOOKUP_PHONE_PARAM=phone
FOURD_EMR_PATIENT_LOOKUP_RESULT_PATH=Items
FOURD_EMR_PATIENT_LOOKUP_PAGE_COUNT=20
FOURD_EMR_PATIENT_LOOKUP_PAGE_SKIP=0
FOURD_EMR_PATIENT_LOOKUP_NEED_TOTAL_COUNT=true
FOURD_EMR_PATIENT_ID_PATH=PatientId
FOURD_EMR_PATIENT_NAME_PATH=
FOURD_EMR_PATIENT_FIRST_NAME_PATH=FirstName
FOURD_EMR_PATIENT_LAST_NAME_PATH=LastName
FOURD_EMR_PATIENT_MRN_PATH=AccountNumber
FOURD_EMR_PATIENT_DOB_PATH=DOB
FOURD_EMR_PATIENT_CHART_PATH=PatientId

# Screen pop / patient-summary chart link
FOURD_EMR_SCREEN_POP_PATH_TEMPLATE=https://app.4d-emr.com/#/patients/nourish/contact?ptId={patientId}
FOURD_EMR_PATIENT_SEARCH_PATH_TEMPLATE=
FOURD_EMR_NEW_PATIENT_PATH_TEMPLATE=/#/patients/nourish/leads

# Appointments (used by /crm/patient-summary)
FOURD_EMR_APPOINTMENT_LOOKUP_PATH=/api/public/appointments
FOURD_EMR_APPOINTMENT_LOOKUP_PATIENT_ID_PARAM=patientId

# Call transcript writeback -- always via Leads (4D EMR support confirmed
# 2026-07-27 chart notes don't land in a visible category; Leads is the
# correct destination for call info/notes for every caller, matched or not).
FOURD_EMR_LEAD_CREATE_PATH=/api/public/leads
FOURD_EMR_LEAD_NOTE_CREATE_PATH=/api/public/leads/notes
FOURD_EMR_LEAD_REFERRING_SOURCE=3CX Inbound Call

# Screen pop behavior
# multi-match options: pick_list | open_first | search
SCREEN_POP_MULTI_MATCH_ACTION=pick_list
# no-match options: new_patient | search | none
SCREEN_POP_NO_MATCH_ACTION=new_patient

# Transcript redaction
REDACT_SSN_IN_TRANSCRIPTS=true

# Session retention for active calls and idempotency keys
CALL_SESSION_TTL_MINUTES=240

# How long a /crm/patient-summary link stays valid after being issued
PATIENT_SUMMARY_LINK_TTL_MINUTES=30
