# Service
PORT=8080
LOG_LEVEL=info
PUBLIC_BASE_URL=https://integration.your-domain.com

# 3CX
THREE_CX_TENANT_URL=https://yourtenant.3cx.us
# Optional but strongly recommended: HMAC SHA-256 secret for webhook signature validation
THREE_CX_WEBHOOK_SECRET=replace-with-random-shared-secret

# 4D EMR
FOURD_EMR_BASE_URL=https://api.your-4d-emr.com
# Use one or both auth methods depending on your 4D EMR API
FOURD_EMR_API_KEY=
FOURD_EMR_BEARER_TOKEN=

# 4D EMR mapping (adjust to match your actual API schema)
FOURD_EMR_PATIENT_LOOKUP_PATH=/api/patients/search
FOURD_EMR_PATIENT_LOOKUP_PHONE_PARAM=phone
FOURD_EMR_PATIENT_LOOKUP_RESULT_PATH=data.patients
FOURD_EMR_PATIENT_ID_PATH=id
FOURD_EMR_PATIENT_NAME_PATH=fullName
FOURD_EMR_PATIENT_MRN_PATH=mrn
FOURD_EMR_PATIENT_DOB_PATH=dateOfBirth
FOURD_EMR_PATIENT_CHART_PATH=chartNumber
FOURD_EMR_SCREEN_POP_PATH_TEMPLATE=/patients/{patientId}
FOURD_EMR_NOTE_CREATE_PATH_TEMPLATE=/api/patients/{patientId}/notes

# Session retention for active calls and idempotency keys
CALL_SESSION_TTL_MINUTES=240
