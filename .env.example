# Binance.US credentials (never commit real secrets)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Trading pair and data interval
SYMBOL=BTCUSDT
INTERVAL=1m
LOOKBACK_CANDLES=300
POLL_SECONDS=60

# Safety controls
PAPER_TRADING=true
MAX_USD_PER_TRADE=25
MIN_TRADE_USD=10
MODEL_CONFIDENCE_THRESHOLD=0.58

# AI model settings
MIN_TRAIN_ROWS=120

# Paper wallet (used only in PAPER_TRADING mode)
PAPER_STARTING_QUOTE_BALANCE=1000
PAPER_STATE_FILE=paper_wallet_state.json
